// Every line the mod says that it wrote itself, in English (strings.h).
//
//   S(KEY, "text")            said as it is
//   F(KEY, "format")          filled in with tfmt: the placeholders are
//                             checked against a translation's, so a
//                             translated line can reorder them (%2$s) but
//                             never change what they take
//   P(KEY, "one", "other")    a line that changes with a count (tpfmt); a
//                             translation gives its language's forms
//
// Grouped by the file that says them, the words several files share first. A
// key is the name in a translation file, so one, once published, is not
// renamed. Text the game itself drew is not here: it is already in the
// player's language, and so are the game's own words the mod looks up
// (game_loc, game_localize). Punctuation that only joins pieces -- ", " and
// ". " between a name and its state -- stays in the code.

// ---- shared: punctuation, numbers, key names and words several files use -------
S(TXT_EMPTY,             "")
S(TXT_STOP,              ".")
P(TXT_TURNS,             "%d turn", "%d turns")
P(TXT_TILES,             "%d tile", "%d tiles")
S(KEY_ENTER,             "Enter")
S(KEY_ESCAPE,            "Escape")
S(TXT_TOP,               "Top.")
S(TXT_END,               "End.")
S(TXT_UNKNOWN,           "Unknown")
F(TXT_NAME_N_OF,         "%s, %d of %d")
F(TXT_HP_OF,             "%d of %d HP")
S(TXT_CLOSED,            "Closed.")
S(TXT_NUM_1,             "one")
S(TXT_NUM_2,             "two")
S(TXT_NUM_3,             "three")
S(TXT_NUM_4,             "four")
S(TXT_NUM_5,             "five")
S(TXT_AND,               " and ")
S(KEY_SPACE,             "Space")
S(KEY_TAB,               "Tab")
S(KEY_LEFT_SHIFT,        "Left Shift")

