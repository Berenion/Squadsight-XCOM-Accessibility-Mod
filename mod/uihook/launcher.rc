#include <windows.h>
#include "resource.h"
#include "version.h"

// A real dialog resource rather than a hand-built window: the #32770 class is
// what makes a screen reader announce this as a dialog, read the prompt on
// open, and then track the focused button as Tab and the arrow keys move.
// Install and Uninstall are hidden, not disabled, when they do not apply: a
// disabled button is skipped by Tab and so would go unexplained.
IDD_LAUNCHER DIALOGEX 0, 0, 232, 164
STYLE DS_MODALFRAME | DS_CENTER | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "XCOM Accessibility Launcher"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Which game do you want to play?", IDC_PROMPT, 12, 10, 208, 10
    PUSHBUTTON      "XCOM: Enemy &Unknown", IDC_EU, 12, 26, 208, 18
    PUSHBUTTON      "XCOM: Enemy &Within", IDC_EW, 12, 48, 208, 18
    LTEXT           "", IDC_STATUS, 12, 72, 208, 32
    PUSHBUTTON      "&Install the mod", IDC_INSTALL, 12, 108, 100, 14
    PUSHBUTTON      "Unin&stall the mod", IDC_UNINSTALL, 120, 108, 100, 14
    PUSHBUTTON      "Check for &updates", IDC_UPDATE, 12, 126, 100, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 170, 144, 50, 14
END

#include "progress.rc"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     MOD_VERSION_MAJOR, MOD_VERSION_MINOR, MOD_VERSION_PATCH, 0
PRODUCTVERSION  MOD_VERSION_MAJOR, MOD_VERSION_MINOR, MOD_VERSION_PATCH, 0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Berenion"
            VALUE "FileDescription",  "Squadsight launcher for XCOM: Enemy Unknown / Enemy Within"
            VALUE "FileVersion",      MOD_VERSION
            VALUE "ProductName",      "Squadsight"
            VALUE "ProductVersion",   MOD_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
