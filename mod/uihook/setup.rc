#include <windows.h>
#include "resource.h"
#include "version.h"

#include "progress.rc"

// The setup's own version is the one it was built with; what it installs is
// whatever release is latest (setup.c).
VS_VERSION_INFO VERSIONINFO
FILEVERSION     MOD_VERSION_MAJOR, MOD_VERSION_MINOR, MOD_VERSION_PATCH, 0
PRODUCTVERSION  MOD_VERSION_MAJOR, MOD_VERSION_MINOR, MOD_VERSION_PATCH, 0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Berenion"
            VALUE "FileDescription",  "Squadsight setup: downloads and installs the XCOM accessibility mod"
            VALUE "FileVersion",      MOD_VERSION
            VALUE "ProductName",      "Squadsight"
            VALUE "ProductVersion",   MOD_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
